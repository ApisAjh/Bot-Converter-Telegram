# Token bot dari @BotFather
BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL publik tempat Vercel meng-host webhook, contoh:
# https://nama-project-anda.vercel.app/api/webhook
WEBHOOK_URL=https://nama-project-anda.vercel.app/api/webhook

# (Opsional tapi disarankan) token rahasia untuk validasi request webhook,
# lihat: https://core.telegram.org/bots/api#setwebhook (secret_token)
WEBHOOK_SECRET=ubah-dengan-string-acak-yang-sulit-ditebak

# (Opsional) batas ukuran file dalam MB, default 20
MAX_FILE_SIZE_MB=20

# Ditandai otomatis oleh Vercel saat deploy, jangan diubah manual.
# Dipakai kode untuk menentukan lokasi folder temp (/tmp vs ./temp).
# VERCEL=1
